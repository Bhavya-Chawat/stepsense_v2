# StepSense Global Environment Configuration Template
# Copy this file to apps/web/.env and apps/mobile/.env with your actual keys

# --- Supabase Configuration ---
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Web App Variables (apps/web/.env) ---
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Mobile App Variables (apps/mobile/.env) ---
EXPO_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
EXPO_NO_DEVTOOLS=1

# --- Optional AI/GROQ API Key (if using Groq LLM Assistant) ---
GROQ_API_KEY="gsk_your_groq_api_key_here"
